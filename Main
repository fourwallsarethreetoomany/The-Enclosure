def clamp(val, min_val, max_val):
    return max(min_val, min(val, max_val))


class PDCRound(pygame.sprite.Sprite): # 40mm PDC
    def __init__(self, x, y, target_pos, owner_is_player):
        super().__init__()
        self.pos = pygame.Vector2(x, y)
        self.owner_is_player = owner_is_player
        
        direction = target_pos - self.pos
        if direction.length_squared() > 0:
            self.velocity = direction.normalize() * (900 / 60)
        else:
            self.velocity = pygame.Vector2(0, 0)
        self.lifetime = 120  # Expires after2 seconds 

    def update(self):
        self.pos += self.velocity
        self.lifetime -= 1
        if self.lifetime <= 0 or not (-200000 <= self.pos.x <= 200000 and -200000 <= self.pos.y <= 200000):
            self.kill()


class RailgunSlug(pygame.sprite.Sprite):
    def __init__(self, x, y, target_pos, owner_is_player):
        super().__init__()
        self.pos = pygame.Vector2(x, y)
        self.owner_is_player = owner_is_player
        self.damage = 160
        
        direction = target_pos - self.pos
        if direction.length_squared() > 0:
            self.velocity = direction.normalize() * 200
        else:
            self.velocity = pygame.Vector2(0, 0)
        self.lifetime = 150

    def update(self):
        self.pos += self.velocity
        self.lifetime -= 1
        if self.lifetime <= 0:
            self.kill()


class PDC: # 40mm PDC system
    def __init__(self, owner, offset=pygame.Vector2(0, 0), range_val=20000, is_player=True):
        self.owner = owner
        self.offset = offset
        self.range = range_val
        self.cooldown = 0
        self.fire_rate = 4 # 4 frames per shot, 1600 rpm
        self.is_player = is_player
        self.current_target = None
        self.lock_timer = 0
        self.last_target_pos = None

    def get_world_pos(self):
        rad = math.radians(-self.owner.angle)
        rx = self.offset.x * math.cos(rad) - self.offset.y * math.sin(rad)
        ry = self.offset.x * math.sin(rad) + self.offset.y * math.cos(rad)
        return self.owner.pos + pygame.Vector2(rx, ry)

    def update(self, potential_targets, rounds_group):
        if self.cooldown > 0:
            self.cooldown -= 1

        mount_pos = self.get_world_pos()

        enemy_missiles = [
            t for t in potential_targets 
            if isinstance(t, Missile) and getattr(t, 'is_player', None) != self.is_player
        ]
        
        closest_target = None
        min_dist = 999999

        closest_missile = None
        min_missile_dist = 3750  # range, it should be max not min 
        for m in enemy_missiles:
            m_pos = m.pos if hasattr(m, 'pos') else pygame.Vector2(m.rect.center)
            dist = mount_pos.distance_to(m_pos)
            if dist <= min_missile_dist and dist < min_dist:
                min_dist = dist
                closest_missile = m

        if closest_missile:
            closest_target = closest_missile
        else:
            enemy_ships = [
                t for t in potential_targets 
                if isinstance(t, Ship) and t.is_player != self.is_player and not getattr(t, 'is_stealth', False)
            ]
            closest_ship = None
            min_ship_dist = 725  # 7,250 meters / 10 but its called min despite being max range 
            min_dist = 999999
            for s in enemy_ships:
                s_pos = s.pos if hasattr(s, 'pos') else pygame.Vector2(s.rect.center)
                dist = mount_pos.distance_to(s_pos)
                if dist <= min_ship_dist and dist < min_dist:
                    min_dist = dist
                    closest_ship = s
            closest_target = closest_ship

        if closest_target:
            if closest_target == self.current_target:
                self.lock_timer = min(30, self.lock_timer + 1)
            else:
                self.current_target = closest_target
                self.lock_timer = 0
            t_pos = closest_target.pos if hasattr(closest_target, 'pos') else pygame.Vector2(closest_target.rect.center)
            self.last_target_pos = t_pos
        else:
            self.current_target = None
            self.lock_timer = 0
            self.last_target_pos = None

        if not self.last_target_pos:
            rad = math.radians(-self.owner.angle)
            self.last_target_pos = mount_pos + pygame.Vector2(math.cos(rad), math.sin(rad)) * 500

        if closest_target and self.cooldown == 0:
            t_pos = closest_target.pos if hasattr(closest_target, 'pos') else pygame.Vector2(closest_target.rect.center)
            
            if isinstance(closest_target, Missile):
                t_vel = getattr(closest_target, 'velocity', pygame.Vector2(0, 0))
                target_rad = math.radians(-getattr(closest_target, 'angle', 0))
                target_forward = pygame.Vector2(math.cos(target_rad), math.sin(target_rad))
                target_accel_mag = getattr(closest_target, 'acceleration_magnitude', 0.0)
                target_accel = target_forward * target_accel_mag

                ship_vel = self.owner.velocity
                
                omega = math.radians(getattr(self.owner, 'angular_velocity', 0.0))
                rad_ship = math.radians(-self.owner.angle)
                rx = self.offset.x * math.cos(rad_ship) - self.offset.y * math.sin(rad_ship)
                ry = self.offset.x * math.sin(rad_ship) + self.offset.y * math.cos(rad_ship)
                r_vector = pygame.Vector2(rx, ry)
                tangential_vel = pygame.Vector2(-omega * r_vector.y, omega * r_vector.x) * 6
                total_owner_vel = ship_vel + tangential_vel
                
                # inertia isn;t factored in the game
                v_rel = t_vel - total_owner_vel
                a_rel = target_accel  # Only use the target's acceleration

                dist = mount_pos.distance_to(t_pos)
                pdc_speed = 5000 * 0.1 / 60
                t_intercept = dist / pdc_speed if pdc_speed > 0 else 1.0
                
                predicted_pos = t_pos + v_rel * t_intercept + 0.5 * a_rel * (t_intercept ** 2)
                
                v_curr = t_pos - mount_pos
                v_pred = predicted_pos - mount_pos
                if v_curr.length_squared() > 0 and v_pred.dot(v_curr) < 0:
                    aim_pos = t_pos
                else:
                    aim_pos = predicted_pos

                self.last_target_pos = aim_pos

            else:
                aim_pos = t_pos
                self.last_target_pos = t_pos

            round_obj = PDCRound(mount_pos.x, mount_pos.y, aim_pos, self.is_player)
            rounds_group.add(round_obj)
            self.cooldown = self.fire_rate



class RailgunWeapon:
    def __init__(self, owner, offset=pygame.Vector2(0, 0), is_player=True):
        self.owner = owner
        self.offset = pygame.Vector2(offset)
        self.range = 150000
        self.cooldown = 0
        self.fire_rate = 85
        self.is_player = is_player
        self.last_target_pos = None

        self.slug_speed = 400.0

    def get_world_pos(self):
        rad = math.radians(-self.owner.angle)

        rx = (
            self.offset.x * math.cos(rad)
            - self.offset.y * math.sin(rad)
        )
        ry = (
            self.offset.x * math.sin(rad)
            + self.offset.y * math.cos(rad)
        )

        return self.owner.pos + pygame.Vector2(rx, ry)

    def calculate_intercept(self, mount_pos, target): #predict future position, returns positiona dn time none if non are found
        target_pos = pygame.Vector2(target.pos)

        target_vel = pygame.Vector2(
            getattr(target, "velocity", pygame.Vector2(0, 0))
        )

        # Target acceleration in its current facing direction.
        target_rad = math.radians(
            -getattr(target, "angle", 0)
        )

        target_forward = pygame.Vector2(
            math.cos(target_rad),
            math.sin(target_rad)
        )

        accel_mag = getattr(
            target, "acceleration_magnitude", 0.0
        )

        target_accel = target_forward * accel_mag

        #   jerk using the target's current heading.
        target_jerk = pygame.Vector2(0, 0)

        if accel_mag > 0:
            target_jerk = target_forward * getattr(
                target, "jerk", 0.0
            )

        #   position and velocity at launch.
        #   the slug inherits the owner's current velocity.
        relative_pos = target_pos - mount_pos

        owner_vel = pygame.Vector2(
            getattr(self.owner, "velocity", pygame.Vector2(0, 0))
        )

        relative_vel = target_vel - owner_vel

        speed = self.slug_speed

        if speed <= 0:
            return target_pos, None

        # A projectile traveling at this speed cannot cover more than this distance within the weapon's range.
        max_time = self.range / speed

        def position_error(t): #helper
            # target position relative to the moving shooter.
            relative_future = ( # I honestly think we should make ap physics 1 include calculus
                relative_pos
                + relative_vel * t
                + 0.5 * target_accel * (t ** 2)
                + (1.0 / 6.0) * target_jerk * (t ** 3) #This will have zero negative consequences towards the performance of the game. 
            ) # ive optimized it as much as i can okay? its already in the taylor series form can you stop running my CPU usage up by 8%?

            # zero means projectile travel distance matches the distance to the predicted target position.
            return relative_future.length() - speed * t # returns difference, positive meand the railgun lags behind, negative means overshoot

        # find the earliest intercept by searching for a sign change then reinfe it with binary search.
        steps = 900 # This also will have no negative consequences towards the performance of the game. oh my god every time i boot up vs code my laptop fan spins up.
        previous_t = 0.0 # this entire loop is basically turning the max flight time into 900 chunks 
        # and we find the exact flight time that will cause a lagging railgun to hit the target. 
        # after we have found a lower and upper bound we feed it into a binary search to find an even more accurate number
        #then after we found the travel time we feed that time into  another kinematics equation to find where
        # the enemy will be then we ensure that the railgun isn;t pointing in the exact opposite direction
        # as the target, and then can fire at the enemy.
        previous_error = position_error(previous_t)  
        for i in range(1, steps + 1): 
            current_t = max_time * i / steps
            current_error = position_error(current_t)

            if previous_error > 0 and current_error <= 0:
                low = previous_t
                high = current_t

                for _ in range(30):
                    mid = (low + high) / 2

                    if position_error(mid) > 0:
                        low = mid
                    else:
                        high = mid

                intercept_time = (low + high) / 2

                # predict the target's world position.
                predicted_pos = (
                    target_pos
                    + target_vel * intercept_time
                    + 0.5 * target_accel * (intercept_time ** 2)
                    + (1.0 / 6.0)
                    * target_jerk
                    * (intercept_time ** 3) # THIS WILL HAVE NO NEGATIVE CONSEQUENCESS TOWARDS THE PERFORMANCE OF THE GAME
                )

                # reject predictions that are behaind the weapon.
                to_pred = predicted_pos - mount_pos
                to_target = target_pos - mount_pos

                if to_pred.dot(to_target) < 0:
                    return target_pos, None

                return predicted_pos, intercept_time

            previous_t = current_t
            previous_error = current_error

        # No valid intercept found.
        return target_pos, None

    def update(self, potential_targets, slugs_group):
        if self.cooldown > 0:
            self.cooldown -= 1

        mount_pos = self.get_world_pos()

        # Railguns deson;t target enemy ships bug fixed
        valid_targets = [
            t for t in potential_targets
            if isinstance(t, Ship)
            and t != self.owner
            and getattr(t, "is_player", None) != self.is_player
        ]

        if not valid_targets:
            self.last_target_pos = None
            return

        # select the closest enemy ship to the weapon mount.
        closest_target = min(
            valid_targets,
            key=lambda t: mount_pos.distance_to(
                t.pos if hasattr(t, "pos")
                else pygame.Vector2(t.rect.center)
            )
        ) # I will say this was less cinematic than what i had in midn

        t_pos = (
            closest_target.pos
            if hasattr(closest_target, "pos")
            else pygame.Vector2(closest_target.rect.center)
        )

        dist = mount_pos.distance_to(t_pos)

        # calculate the predicted intercept on every frame.
        predicted_pos, intercept_time = self.calculate_intercept(
            mount_pos,
            closest_target
        )

        self.last_target_pos = predicted_pos

        # Leonidas-class ships cannot fire while accelerating. womp womp
        can_fire = True

        if (
            getattr(
                self.owner,
                "cannot_fire_while_accelerating",
                False
            )
            and getattr(
                self.owner,
                "acceleration_magnitude",
                0.0) > 0
        ):
            can_fire = False

        # Fire only when a valid intercept is available.
        if (
            intercept_time is not None
            and dist <= self.range
            and self.cooldown == 0
            and can_fire
        ):
            keys = pygame.key.get_pressed()

            if not self.is_player or keys[pygame.K_r]:
                slug = RailgunSlug(
                    mount_pos.x,
                    mount_pos.y,
                    predicted_pos,
                    self.is_player
                )

                slugs_group.add(slug)
                self.cooldown = self.fire_rate


class Missile(pygame.sprite.Sprite):
    def __init__(self, x, y, angle, target, is_player=True, initial_velocity=None, damage=50, hp=10, max_speed=450):
        super().__init__()
        self.is_player = is_player
        self.image = pygame.Surface((12, 4), pygame.SRCALPHA)
        pygame.draw.rect(self.image, (0, 150, 255) if is_player else (255, 50, 50), (0, 0, 12, 4))
        self.original_image = self.image.copy()
        self.rect = self.image.get_rect(center=(x, y))
        
        self.pos = pygame.Vector2(x, y)
        self.acceleration_magnitude = ((40 * 9.80665) / 360.0) * 0.67  
        base_vel = initial_velocity if initial_velocity is not None else pygame.Vector2(0, 0)
        self.velocity = base_vel + pygame.Vector2(math.cos(angle), math.sin(angle)) * 5
        self.target = target
        self.hp = hp
        self.damage = damage
        self.max_speed_m_s = max_speed
        self.fuel_timer = 240  

    def take_damage(self, amount):
        self.hp -= amount
        if self.hp <= 0:
            self.kill()

    def update(self):
        self.fuel_timer -= 1
        if self.fuel_timer <= 0 or (self.target and not self.target.alive()):
            self.kill()
            return

        if self.target:
            target_pos = self.target.pos
            to_target = target_pos - self.pos
            dist = to_target.length()
            
            is_stealth = getattr(self.target, 'is_stealth', False)

            if dist <= 350 and not is_stealth: # hard burn when close to target
                self.acceleration_magnitude = ((100 * 9.80665) / 360.0) * 0.5
                if to_target.length_squared() > 0:
                    desired_dir = to_target.normalize()
                    speed = self.velocity.length() + self.acceleration_magnitude * 1.1
                    max_speed_pix = self.max_speed_m_s / 6 + 50  # convert m/s to pixels/frame but we add a little bit
                    speed = min(speed, max_speed_pix)
                    self.velocity = desired_dir * speed
            else:
                self.acceleration_magnitude = ((32.5 * 9.80665) / 360.0) * 0.5
                if to_target.length_squared() > 0:
                    desired_dir = to_target.normalize()
                    current_dir = self.velocity.normalize() if self.velocity.length_squared() > 0 else desired_dir
                    
                    steer_strength = 0.25
                    new_dir = current_dir.lerp(desired_dir, steer_strength)
                    if new_dir.length_squared() > 0:
                        new_dir = new_dir.normalize()
                    else:
                        new_dir = desired_dir
                    
                    speed = self.velocity.length() + self.acceleration_magnitude
                    max_speed_pix = self.max_speed_m_s / 6
                    speed = min(speed, max_speed_pix)
                    
                    self.velocity = new_dir * speed
                    
                if self.velocity.length_squared() > 0:
                    angle_deg = -math.degrees(math.atan2(self.velocity.y, self.velocity.x))
                    old_center = self.rect.center
                    self.image = pygame.transform.rotate(self.original_image, angle_deg)
                    self.rect = self.image.get_rect(center=old_center)

        self.pos += self.velocity
        self.rect.center = (int(self.pos.x), int(self.pos.y))

        if not (-30000 <= self.pos.x <= 30000 and -30000 <= self.pos.y <= 30000):
            self.kill()


class LightTorpedo(Missile):
    def __init__(self, x, y, angle, target, is_player=True, initial_velocity=None):
        super().__init__(x, y, angle, target, is_player, initial_velocity, damage=50, hp=2, max_speed=325)


class MediumTorpedo(Missile):
    def __init__(self, x, y, angle, target, is_player=True, initial_velocity=None):
        super().__init__(x, y, angle, target, is_player, initial_velocity, damage=80, hp=4, max_speed=310)


class HeavyTorpedo(Missile):
    def __init__(self, x, y, angle, target, is_player=True, initial_velocity=None):
        super().__init__(x, y, angle, target, is_player, initial_velocity, damage=115, hp=8, max_speed=255)


class NukeTorpedo(Missile):
    def __init__(self, x, y, angle, target, is_player=True, initial_velocity=None):
        super().__init__(x, y, angle, target, is_player, initial_velocity, damage=355, hp=10, max_speed=235)


def create_ship_surface(length, height, team):
    surf = pygame.Surface((length, height), pygame.SRCALPHA)
    color = (0, 255, 150) if team == "blue" else (255, 50, 50)
    pygame.draw.polygon(surf, color, [(0, 0), (length, height // 2), (0, height)])
    return surf


class Ship(pygame.sprite.Sprite): #parent class of all ships
    def __init__(self, x, y, length, height, armor, hull, max_speed, jerk, angle=0, is_player=True, team="blue"):
        super().__init__()
        self.angle = angle
        self.team = team
        self.original_image = create_ship_surface(length, height, team)
        self.image = self.original_image.copy()
        self.rect = self.image.get_rect(center=(x, y))

        self.pos = pygame.Vector2(x, y)
        self.velocity = pygame.Vector2(0, 0)
        self.acceleration_magnitude = 0.0
        
        # Ship Class Stats
        self.hull = hull
        self.max_hull = hull
        self.armor = armor
        self.max_speed_pix = max_speed / 6  # m/s to pixels/frame conversion
        self.jerk = jerk
        
        self.subsystems = {
            "bridge": {"hp": 200, "max_hp": 200, "status": "Stable"},
            "power": {"hp": 160, "max_hp": 160, "status": "Stable"},
            "drive_system": {"hp": 50, "max_hp": 50, "status": "Stable"}, # scrapped
            "fcs": {"hp": 30, "max_hp": 30, "status": "Stable"} #scrapped
        }

        self.is_player = is_player
        self.blackout_timer = 0
        self.g_force = 0.0
        self.is_stealth = False
        self.cannot_fire_while_accelerating = False
        self.missile_cooldown = 0
        self.ammo = {'light': 0, 'medium': 0, 'heavy': 0, 'nuke': 0}
        self.burst_config = None
        self.active_bursts = []

    def take_damage(self, amount, weapon_name="Weapon", attacker_pos=None):
        actual_hull_dmg = max(1, amount * 1/(1+(self.armor/100)))
        self.hull -= actual_hull_dmg
        if self.hull < 0:
            self.hull = 0

        # Subsystems do not take damage unless the hull is 0
        if self.hull <= 0:
            eligible = ["bridge", "drive_system", "fcs"]
            
            if attacker_pos is not None:
                rad = math.radians(-self.angle)
                forward_dir = pygame.Vector2(math.cos(rad), math.sin(rad))
                rear_dir = -forward_dir
                to_ship = self.pos - attacker_pos
                if to_ship.length_squared() > 0:
                    attack_dir = to_ship.normalize()
                    dot = rear_dir.dot(attack_dir)
                    if dot >= 0.707:
                        eligible.append("power")

            for sub_name in eligible:
                sub = self.subsystems[sub_name]
                if sub["status"] == "destroyed":
                    continue
                
                armor_factor = 1 / (1 + (self.armor/100))
                if armor_factor <= 0:
                    armor_factor = 0.01
                
                sub_dmg = amount * armor_factor
                sub["hp"] -= sub_dmg
                if sub["hp"] <= 0:
                    sub["hp"] = 0
                    sub["status"] = "destroyed"

        if self.subsystems["bridge"]["hp"] <= 0 or self.subsystems["power"]["hp"] <= 0:
            self.kill()

    def rotate_image(self, target_angle_deg):
        self.angle = target_angle_deg
        old_center = self.rect.center
        self.image = pygame.transform.rotate(self.original_image, self.angle)
        self.rect = self.image.get_rect(center=old_center)

    def update_physics(self):
        old_velocity = pygame.Vector2(self.velocity)
        if self.acceleration_magnitude > 0:
            rad = math.radians(-self.angle)
            forward_dir = pygame.Vector2(math.cos(rad), math.sin(rad))
            self.velocity += forward_dir * (self.acceleration_magnitude * 0.02)
            if self.velocity.length() > self.max_speed_pix:
                self.velocity = self.velocity.normalize() * self.max_speed_pix

        frame_accel = self.velocity - old_velocity
        self.g_force = frame_accel.length() / 0.20

        self.pos += self.velocity
        self.rect.center = (int(self.pos.x), int(self.pos.y))

    def try_fire_missiles(self, target_obj, missiles_group):
        if not target_obj or not target_obj.alive():
            return
        
        if self.burst_config:
            can_fire = True
            for m_type in self.ammo:
                if self.ammo[m_type] < 0:
                    can_fire = False
            if not can_fire:
                return

            self.active_bursts.append({
                'bursts_remaining': self.burst_config['count'],
                'interval': self.burst_config['interval'],
                'timer': 0,
                'target': target_obj,
                'payloads': self.burst_config.get('bursts_payload', None)
            })
            self.missile_cooldown = self.burst_config.get('cooldown', 300)
        elif hasattr(self, 'missile_payload') and self.missile_payload:
            can_fire = True
            for m_type in self.missile_payload:
                if self.ammo.get(m_type, 0) <= 0:
                    can_fire = False
            if not can_fire:
                return

            launch_rad = math.radians(-self.angle)
            forward = pygame.Vector2(math.cos(launch_rad), math.sin(launch_rad))
            perp = pygame.Vector2(-forward.y, forward.x)
            for m_type in self.missile_payload:
                if self.ammo.get(m_type, 0) > 0:
                    self.ammo[m_type] -= 1

                side_speed = random.uniform(2.0, 10.0)
                side_dir = random.choice([-1, 1])
                init_vel = self.velocity + perp * (side_dir * side_speed)
                if m_type == 'light':
                    missiles_group.add(LightTorpedo(self.pos.x, self.pos.y, launch_rad, target_obj, is_player=self.is_player, initial_velocity=init_vel))
                elif m_type == 'medium':
                    missiles_group.add(MediumTorpedo(self.pos.x, self.pos.y, launch_rad, target_obj, is_player=self.is_player, initial_velocity=init_vel))
                elif m_type == 'heavy':
                    missiles_group.add(HeavyTorpedo(self.pos.x, self.pos.y, launch_rad, target_obj, is_player=self.is_player, initial_velocity=init_vel))
                elif m_type == 'nuke':
                    missiles_group.add(NukeTorpedo(self.pos.x, self.pos.y, launch_rad, target_obj, is_player=self.is_player, initial_velocity=init_vel))
            self.missile_cooldown = 400

    def update_missile_bursts(self, missiles_group):
        if self.missile_cooldown > 0:
            self.missile_cooldown -= 1

        for burst in list(self.active_bursts):
            if burst['timer'] > 0:
                burst['timer'] -= 1
            else:
                target_obj = burst['target']
                if target_obj and target_obj.alive():
                    launch_rad = math.radians(-self.angle)
                    forward = pygame.Vector2(math.cos(launch_rad), math.sin(launch_rad))
                    perp = pygame.Vector2(-forward.y, forward.x)

                    if burst['payloads']:
                        idx = self.burst_config['count'] - burst['bursts_remaining']
                        current_payload = burst['payloads'][idx]
                    else:
                        current_payload = self.burst_config['per_burst']

                    for m_type in current_payload:
                        if m_type in self.ammo:
                            if self.ammo[m_type] > 0:
                                self.ammo[m_type] -= 1
                            else:
                                continue

                        side_speed = random.uniform(2.0, 10.0)
                        side_dir = random.choice([-1, 1])
                        init_vel = self.velocity + perp * (side_dir * side_speed)
                        if m_type == 'light':
                            missiles_group.add(LightTorpedo(self.pos.x, self.pos.y, launch_rad, target_obj, is_player=self.is_player, initial_velocity=init_vel))
                        elif m_type == 'medium':
                            missiles_group.add(MediumTorpedo(self.pos.x, self.pos.y, launch_rad, target_obj, is_player=self.is_player, initial_velocity=init_vel))
                        elif m_type == 'heavy':
                            missiles_group.add(HeavyTorpedo(self.pos.x, self.pos.y, launch_rad, target_obj, is_player=self.is_player, initial_velocity=init_vel))
                        elif m_type == 'nuke':
                            missiles_group.add(NukeTorpedo(self.pos.x, self.pos.y, launch_rad, target_obj, is_player=self.is_player, initial_velocity=init_vel))

                burst['bursts_remaining'] -= 1
                if burst['bursts_remaining'] <= 0:
                    self.active_bursts.remove(burst)
                else:
                    burst['timer'] = burst['interval']


def update_player_ship(ship, keys):
    if ship.blackout_timer > 0:
        ship.blackout_timer -= 1
        ship.velocity *= 0.95  
        ship.acceleration_magnitude = 0.0
        ship.pos += ship.velocity
        ship.rect.center = (int(ship.pos.x), int(ship.pos.y))
        return

    if keys[pygame.K_w]:
        ship.acceleration_magnitude += ship.jerk
    else:
        ship.acceleration_magnitude = max(0.0, ship.acceleration_magnitude - ship.jerk * 2.0)

    ship.update_physics()

    if ship.g_force > 8.5: 
        ship.blackout_timer = 120  
        ship.acceleration_magnitude *= 0.45


def update_ai_ship(ship, target_pos, target_obj, missiles_group):
    to_target = target_pos - ship.pos
    if to_target.length_squared() > 0:
        target_angle_deg = -math.degrees(math.atan2(to_target.y, to_target.x))
        angle_diff = (target_angle_deg - ship.angle + 180) % 360 - 180
        ship.angle += clamp(angle_diff, -2.5, 2.5)
        ship.rotate_image(ship.angle)

        if getattr(ship, 'is_blue_battleship', False):
            if to_target.length() < 12000 and abs(angle_diff) < 20:
                ship.acceleration_magnitude = max(0.0, ship.acceleration_magnitude - ship.jerk * 1.5)
            else:
                if abs(angle_diff) < 35 and to_target.length() > 2500:
                    ship.acceleration_magnitude += ship.jerk
                else:
                    ship.acceleration_magnitude = max(0.0, ship.acceleration_magnitude - ship.jerk * 1.5)
        else:
            if abs(angle_diff) < 35 and to_target.length() > 2500:
                ship.acceleration_magnitude += ship.jerk
            else:
                ship.acceleration_magnitude = max(0.0, ship.acceleration_magnitude - ship.jerk * 1.5)

    ship.update_physics()
    ship.update_missile_bursts(missiles_group)

    if ship.missile_cooldown <= 0:
        if to_target.length() < 100000:
            ship.try_fire_missiles(target_obj, missiles_group)

