        self.ammo = {'light': 120, 'medium': 60, 'heavy': 30, 'nuke': 0}
        self.missile_cooldown = 0
    def update_player(self, keys): update_player_ship(self, keys)
    def update_ai(self, target_pos, target_obj, missiles_group): update_ai_ship(self, target_pos, target_obj, missiles_group)

class CommandShip(Ship): #highest armor due to protomolecule derived armor
    def __init__(self, x, y, is_player=True):
        super().__init__(x, y, length=98, height=42, armor=210, hull=850, max_speed=105, jerk=0.35, is_player=is_player, team="blue")
        self.ship_type = "UNN Command Ship"
        pdc_offsets = [pygame.Vector2(44, 0), pygame.Vector2(24,0), #14 PDCS
                       pygame.Vector2(18, -18), pygame.Vector2(18, 18), 
                       pygame.Vector2(-8, -18), pygame.Vector2(-8, 18),
                         pygame.Vector2(-42, -12), pygame.Vector2(-42, 12),
                         pygame.Vector2(-32,-10), pygame.Vector2(-32,10),
                         pygame.Vector2(24,0), pygame.Vector2(22,0),
                         pygame.Vector2(-9,-9), pygame.Vector2(-9,9)
                         ]
        railgun_offsets = [pygame.Vector2(32, 0), pygame.Vector2(32, 0)]
        self.pdcs = [PDC(self, offset=offset, is_player=is_player) for offset in pdc_offsets]
        self.railguns = [RailgunWeapon(self, offset=offset, is_player=is_player) for offset in railgun_offsets]
        self.missile_payload = ['light'] *4 + ['medium']*6 + ['heavy']
        self.ammo = {'light': 88, 'medium': 72, 'heavy': 12, 'nuke': 0}
        self.missile_cooldown = 0
    def update_player(self, keys): update_player_ship(self, keys)
    def update_ai(self, target_pos, target_obj, missiles_group): update_ai_ship(self, target_pos, target_obj, missiles_group)

class Dreadnought(Ship):
    def __init__(self, x, y, is_player=True):
        super().__init__(x, y, length=106, height=46, armor=80, hull=950, max_speed=85, jerk=0.25, is_player=is_player, team="blue")
        self.ship_type = "UNN Dreadnought"
        pdc_offsets = [pygame.Vector2(48, 0), pygame.Vector2(-52,0),
                        pygame.Vector2(20, -20), pygame.Vector2(20, 20),
                          pygame.Vector2(-10, -20), pygame.Vector2(-10, 20), 
                          pygame.Vector2(-46, -14), pygame.Vector2(-46, 14),
                          pygame.Vector2(-20,-15), pygame.Vector2(-20,15),
                          pygame.Vector2(0,0), pygame.Vector2(0,0),
                          pygame.Vector2(4,4), pygame.Vector2(-4,4),
                          pygame.Vector2(4,4), pygame.Vector2(4,-4),
                          pygame.Vector2(12,12), pygame.Vector2(12,-12)]
        railgun_offsets = [pygame.Vector2(20, 0), pygame.Vector2(20, 0)]
        self.pdcs = [PDC(self, offset=offset, is_player=is_player) for offset in pdc_offsets]
        self.railguns = [RailgunWeapon(self, offset=offset, is_player=is_player) for offset in railgun_offsets]
        self.missile_payload = ['medium']*6 + ['heavy']*2 + ['nuke']
        self.ammo = {'light': 0, 'medium': 66, 'heavy': 22, 'nuke': 11}
        self.missile_cooldown = 0
    def update_player(self, keys): update_player_ship(self, keys)
    def update_ai(self, target_pos, target_obj, missiles_group): update_ai_ship(self, target_pos, target_obj, missiles_group)

class DreadnoughtRefit(Ship):
    def __init__(self, x, y, is_player=True):
        super().__init__(x, y, length=106, height=46, armor=87.5, hull=1050, max_speed=95, jerk=0.3, is_player=is_player, team="blue")
        self.ship_type = "UNN Dreadnought Refit"
        pdc_offsets = [pygame.Vector2(48, 0), pygame.Vector2(-52,0),
                        pygame.Vector2(20, -20), pygame.Vector2(20, 20),
                          pygame.Vector2(-10, -20), pygame.Vector2(-10, 20), 
                          pygame.Vector2(-46, -14), pygame.Vector2(-46, 14),
                          pygame.Vector2(-20,-15), pygame.Vector2(-20,15),
                          pygame.Vector2(0,0), pygame.Vector2(0,0),
                          pygame.Vector2(4,4), pygame.Vector2(-4,4),
                          pygame.Vector2(4,4), pygame.Vector2(4,-4),
                          pygame.Vector2(12,12), pygame.Vector2(12,-12)]
        railgun_offsets = [pygame.Vector2(20, 0), pygame.Vector2(20, 0)]
        railgun_offsets = [pygame.Vector2(20, 0), pygame.Vector2(20, 0)]
        self.pdcs = [PDC(self, offset=offset, is_player=is_player) for offset in pdc_offsets]
        self.railguns = [RailgunWeapon(self, offset=offset, is_player=is_player) for offset in railgun_offsets]
        self.missile_payload = ['light']*12 + ['medium']*6 + ['heavy']*4 + ['nuke', 'nuke']
        self.ammo = {'light': 240, 'medium': 120, 'heavy': 80, 'nuke': 40}
        self.missile_cooldown = 0
    def update_player(self, keys): update_player_ship(self, keys)
    def update_ai(self, target_pos, target_obj, missiles_group): update_ai_ship(self, target_pos, target_obj, missiles_group)

async def main():
    # Parallax background stars [x, y, size]
    stars = [[random.randint(0, WIDTH), random.randint(0, HEIGHT), random.randint(1, 3)] for _ in range(150)]

    font = pygame.font.SysFont(None, 24)
    title_font = pygame.font.SysFont(None, 36)

    # Menu state
    blue_roster_classes = [Gunship, Escort, TorpedoBoat, BlueFrigate, BlueDestroyer, BlueBattleship, CommandShip, Dreadnought, DreadnoughtRefit]
    blue_roster_names = ["UNN Greenville", "UNN Ravi", "UNN Jimenez", "UNN Darius", "UNN Raskolnikov", "UNN Jawaharlal", "UNN Zenobia", "UNN Truman", "UNN Tripoli"]

    red_roster_classes = [RedPatrolDestroyer, RedLightFrigate, RedHeavyFrigate, RedDestroyer, StealthDestroyer, StrikeCruiser, AssaultCruiser, RedBattleship, RedBattleshipRefit]
    red_roster_names = ["MCRN Koto", "MCRN Tachi", "MCRN Cydonia", "MCRN Iani Chaos", "MCRN Banshee", "MCRN Pella(MARCO INAROS)", "MCRN Scirocco", "MCRN Donnager", "MCRN Barkeith"]

    selected_player_team = "blue"  
    selected_player_idx = 0
    selected_enemy_class_idx = 0
    enemy_counts = {name: 0 for name in red_roster_names}
    enemy_counts["Light Frigate"] = 1

    running = True

    def init_battle():
        if selected_player_team == "blue":
            p_class = blue_roster_classes[selected_player_idx]
            e_classes = red_roster_classes
            e_names = red_roster_names
        else:
            p_class = red_roster_classes[selected_player_idx]
            e_classes = blue_roster_classes
            e_names = blue_roster_names

        new_player = p_class(WIDTH // 2, HEIGHT // 2, is_player=True)

        new_enemy_group = pygame.sprite.Group()
        for i, stype in enumerate(e_names):
            count = enemy_counts[stype]
            if count > 0:
                cls = e_classes[i]
                for _ in range(count):
                    angle = random.uniform(0, 2 * math.pi)
                    spawn_pos = new_player.pos + pygame.Vector2(math.cos(angle), math.sin(angle)) * 1500
                    en = cls(spawn_pos.x, spawn_pos.y, is_player=False)
                    new_enemy_group.add(en)

        if len(new_enemy_group) == 0:
            angle = random.uniform(0, 2 * math.pi)
            spawn_pos = new_player.pos + pygame.Vector2(math.cos(angle), math.sin(angle)) * 1500
            en = e_classes[0](spawn_pos.x, spawn_pos.y, is_player=False)
            new_enemy_group.add(en)

        return new_player, new_enemy_group, pygame.sprite.Group(new_player), pygame.sprite.Group(), pygame.sprite.Group(), pygame.sprite.Group(), [], []


    def add_notification(text, notifications):
        notifications.append({"text": text, "timer": 90}) #1.5 seconds at 60 FPS


    def add_intercept_notification(text, intercept_notifications):
        intercept_notifications.append({"text": text, "timer": 60}) # 1 second deacy at 60 FPS

    
    while running: # Blue is United Nations Navy, default. Red is Martian Congressional Republic Navy.
        # MENU
        in_menu = True
        while running and in_menu:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                    in_menu = False
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_TAB:
                        selected_player_team = "red" if selected_player_team == "blue" else "blue"
                        selected_player_idx = 0
                        enemy_counts = {name: 0 for name in (red_roster_names if selected_player_team == "blue" else blue_roster_names)}
                        if selected_player_team == "blue":
                            enemy_counts["Light Frigate"] = 1
                        else:
                            enemy_counts["Gunship"] = 1
                    elif event.key == pygame.K_UP:
                        max_idx = len(blue_roster_names) if selected_player_team == "blue" else len(red_roster_names)
                        selected_player_idx = (selected_player_idx - 1) % max_idx
                    elif event.key == pygame.K_DOWN:
                        max_idx = len(blue_roster_names) if selected_player_team == "blue" else len(red_roster_names)
                        selected_player_idx = (selected_player_idx + 1) % max_idx
                    elif event.key == pygame.K_w:
                        max_idx = len(red_roster_names) if selected_player_team == "blue" else len(blue_roster_names)
                        selected_enemy_class_idx = (selected_enemy_class_idx - 1) % max_idx
                    elif event.key == pygame.K_s:
                        max_idx = len(red_roster_names) if selected_player_team == "blue" else len(blue_roster_names)
                        selected_enemy_class_idx = (selected_enemy_class_idx + 1) % max_idx
                    elif event.key == pygame.K_LEFT or event.key == pygame.K_a:
                        names = red_roster_names if selected_player_team == "blue" else blue_roster_names
                        stype = names[selected_enemy_class_idx]
                        enemy_counts[stype] = max(0, enemy_counts[stype] - 1)
                    elif event.key == pygame.K_RIGHT or event.key == pygame.K_d:
                        names = red_roster_names if selected_player_team == "blue" else blue_roster_names
                        stype = names[selected_enemy_class_idx]
                        enemy_counts[stype] = min(10, enemy_counts[stype] + 1)
                    elif event.key == pygame.K_RETURN:
                        in_menu = False

            screen.fill((20, 20, 20))

            title_render = title_font.render("Menu", True, (255, 255, 255))
            screen.blit(title_render, (WIDTH // 2 - title_render.get_width() // 2, 20))

            team_prompt = font.render(f"Player Team: {selected_player_team.upper()} (Press [TAB] to switch team)", True, (255, 215, 0))
            screen.blit(team_prompt, (100, 70))

            p_label = font.render(f"Your Ship ({selected_player_team.upper()} Roster, UP/DOWN):", True, (0, 255, 150))
            screen.blit(p_label, (100, 110))
            current_roster_names = blue_roster_names if selected_player_team == "blue" else red_roster_names
            for i, stype in enumerate(current_roster_names):
                color = (255, 255, 255) if i != selected_player_idx else (0, 255, 150)
                prefix = "> " if i == selected_player_idx else "  "
                opt_render = font.render(f"{prefix}{stype}", True, color)
                col_offset = 120 if i < 5 else 320
                row_idx = i % 5
                screen.blit(opt_render, (col_offset, 140 + row_idx * 24))

            e_label = font.render("Enemy Ship Counts (W/S select class, LEFT/RIGHT change count (a/d also)):", True, (255, 50, 50))
            screen.blit(e_label, (100, 280))
            enemy_roster_names = red_roster_names if selected_player_team == "blue" else blue_roster_names
            for i, stype in enumerate(enemy_roster_names):
                color = (255, 255, 255) if i != selected_enemy_class_idx else (255, 50, 50)
                prefix = "> " if i == selected_enemy_class_idx else "  "
                count = enemy_counts[stype]
                opt_render = font.render(f"{prefix}{stype}: {count}", True, color)
                col_offset = 120 if i < 5 else 320
                row_idx = i % 5
                screen.blit(opt_render, (col_offset, 310 + row_idx * 24))

            start_prompt = font.render("Press [ENTER] to Start Battle", True, (255, 215, 0))
            screen.blit(start_prompt, (WIDTH // 2 - start_prompt.get_width() // 2, 530))

            pygame.display.flip()
            clock.tick(60)

        if not running:
            break

        player, enemy_group, player_group, missiles_group, pdc_rounds_group, slugs_group, notifications, intercept_notifications = init_battle()
        game_over = False
        game_over_message = ""
        battle_running = True

        while running and battle_running:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                    battle_running = False
                elif event.type == pygame.KEYDOWN:
                    if game_over and event.key == pygame.K_r:
                        battle_running = False  # Return to main menu
                    elif not game_over and event.key == pygame.K_f:
                        target_enemy = next((en for en in enemy_group if en.alive()), None)
                        if target_enemy:
                            player.try_fire_missiles(target_enemy, missiles_group)

            keys = pygame.key.get_pressed()
            screen_center = pygame.Vector2(WIDTH / 2, HEIGHT / 2)

            mouse_pos = pygame.Vector2(pygame.mouse.get_pos())
            target_vec = mouse_pos - screen_center

            if not game_over:
                # Check game over conditions (Death only when Bridge or Power reaches 0 HP)
                if not player.alive():
                    game_over = True
                    game_over_message = "DEFEAT You Died! Press [R] to Return to Menu"
                elif not enemy_group or all(not en.alive() for en in enemy_group):
                    game_over = True
                    game_over_message = "VICTORY All Enemies Destroyed! Press [R] to Return to Menu"

                if not game_over:
                    if pygame.mouse.get_pressed()[0] and target_vec.length_squared() > 0:
                        click_angle = math.atan2(target_vec.y, target_vec.x)
                        player.rotate_image(-math.degrees(click_angle))

                    player.update_missile_bursts(missiles_group)
                    player.update_player(keys)

                    for en in enemy_group:
                        target_player = player if player.alive() else None
                        if target_player:
                            en.update_ai(player.pos, target_player, missiles_group)

                    all_targets = list(player_group) + list(enemy_group) + list(missiles_group)
                    
                    for pdc in player.pdcs:
                        pdc.update(all_targets, pdc_rounds_group)
                    for rg in player.railguns:
                        rg.update(all_targets, slugs_group)

                    for en in enemy_group:
                        for pdc in en.pdcs:
                            pdc.update(all_targets, pdc_rounds_group)
                        for rg in en.railguns:
                            rg.update(all_targets, slugs_group)
                        
                    missiles_group.update()
                    pdc_rounds_group.update()
                    slugs_group.update()

                    for round_obj in pdc_rounds_group:
                        if round_obj.owner_is_player:
                            hit_enemy = False
                            for en in enemy_group:
                                if en.alive() and en.rect.inflate(1, 1).collidepoint(round_obj.pos):
                                    if en.hull == 0:
                                        en.take_damage(1, weapon_name="PDC", attacker_pos=round_obj.pos - round_obj.velocity)
                                    else: 
                                        en.hull = max(0.1, en.hull - max(1, 1 - en.armor))
                                    round_obj.kill()
                                    hit_enemy = True
                                    break
                            if not hit_enemy:
                                for m in missiles_group:
                                    if not m.is_player and m.rect.inflate(1, 1).collidepoint(round_obj.pos):
                                        m.take_damage(2)
                                        round_obj.kill()
                                        if m.hp <= 0:
                                            add_intercept_notification(f"Enemy {m.__class__.__name__} intercepted by PDC!", intercept_notifications)
                                        break
                        else:
                            if player.rect.inflate(1, 1).collidepoint(round_obj.pos):
                                player.hull = max(0, player.hull - max(1, 1 - player.armor))
                                round_obj.kill()
                            else:
                                for m in missiles_group:
                                    if m.is_player and m.rect.inflate(1, 1).collidepoint(round_obj.pos):
                                        m.take_damage(2)
                                        round_obj.kill()
                                        if m.hp <= 0:
                                            add_intercept_notification(f"Your {m.__class__.__name__} intercepted by Enemy PDC!", intercept_notifications)
                                        break

                    for slug in slugs_group:
                        if slug.owner_is_player:
                            for en in enemy_group:
                                if en.alive() and en.rect.collidepoint(slug.pos):
                                    en.take_damage(slug.damage, weapon_name="Railgun Slug", attacker_pos=slug.pos - slug.velocity)
                                    add_notification(f"HIT! Your Railgun Slug hit Enemy {en.ship_type}", notifications)
                                    slug.kill()
                                    break
                        else:
                            if player.pos.distance_to(slug.pos) < 20:
                                player.take_damage(slug.damage, weapon_name="Railgun Slug", attacker_pos=slug.pos - slug.velocity)
                                add_notification(f"HIT! Hit by Enemy Railgun Slug", notifications)
                                slug.kill()

                    for m in missiles_group:
                        m_name = m.__class__.__name__
                        if m.is_player:
                            for en in enemy_group:
                                if en.alive() and en.rect.collidepoint(m.pos):
                                    en.take_damage(m.damage, weapon_name=m_name, attacker_pos=m.pos - m.velocity)
                                    add_notification(f"HIT! Your {m_name} hit Enemy {en.ship_type}", notifications)
                                    m.kill()
                                    break
                        else:
                            if player.pos.distance_to(m.pos) < 20:
                                player.take_damage(m.damage, weapon_name=m_name, attacker_pos=m.pos - m.velocity)
                                add_notification(f"HIT! Hit by Enemy {m_name}", notifications)
                                m.kill()

            camera_offset = player.pos - screen_center

            screen.fill((20, 20, 20))

            for star in stars:
                if not game_over:
                    star[0] -= player.velocity.x * 0.01
                    star[1] -= player.velocity.y * 0.02
                if star[0] < 0: star[0] += WIDTH
                if star[0] > WIDTH: star[0] -= WIDTH
                if star[1] < 0: star[1] += HEIGHT
                if star[1] > HEIGHT: star[1] -= HEIGHT
                pygame.draw.circle(screen, (150, 150, 150), (int(star[0]), int(star[1])), star[2])

            player_screen_rect = player.image.get_rect(center=(screen_center.x, screen_center.y))
            screen.blit(player.image, player_screen_rect)

            if player.velocity.length_squared() > 0.1:
                vel_dir = player.velocity.normalize()
                arrow_tip = screen_center + vel_dir * min(player.velocity.length() * 4, 60)
                pygame.draw.line(screen, (0, 255, 100), screen_center, arrow_tip, 2)
                head_angle = math.radians(35)
                angle_v = math.atan2(vel_dir.y, vel_dir.x)
                left_wing = arrow_tip - pygame.Vector2(math.cos(angle_v - head_angle), math.sin(angle_v - head_angle)) * 8
                right_wing = arrow_tip - pygame.Vector2(math.cos(angle_v + head_angle), math.sin(angle_v + head_angle)) * 8
                pygame.draw.polygon(screen, (0, 255, 100), [arrow_tip, left_wing, right_wing])

            for rg in player.railguns:
                if rg.last_target_pos:
                    mount_screen = rg.get_world_pos() - camera_offset
                    target_screen = rg.last_target_pos - camera_offset
                    pygame.draw.line(screen, (160, 32, 240), mount_screen, target_screen, 1)
            for en in enemy_group:
                for rg in en.railguns:
                    if rg.last_target_pos:
                        mount_screen = rg.get_world_pos() - camera_offset
                        target_screen = rg.last_target_pos - camera_offset
                        pygame.draw.line(screen, (160, 32, 240), mount_screen, target_screen, 1)

            def draw_pdc_indicator(pdc):
                if pdc.last_target_pos:
                    p_screen = pdc.last_target_pos - camera_offset
                    length = 3
                    pygame.draw.line(screen, (255, 255, 255), p_screen + pygame.Vector2(-length, 0), p_screen + pygame.Vector2(-2, 0), 2)
                    pygame.draw.line(screen, (255, 255, 255), p_screen + pygame.Vector2(2, 0), p_screen + pygame.Vector2(length, 0), 2)
                    pygame.draw.line(screen, (255, 255, 255), p_screen + pygame.Vector2(0, -length), p_screen + pygame.Vector2(0, -2), 2)
                    pygame.draw.line(screen, (255, 255, 255), p_screen + pygame.Vector2(0, 2), p_screen + pygame.Vector2(0, length), 2)

            for pdc in player.pdcs:
                draw_pdc_indicator(pdc)
            for en in enemy_group:
                for pdc in en.pdcs:
                    draw_pdc_indicator(pdc)

            for en in enemy_group:
                en_screen_pos = en.pos - camera_offset
                en_rect = en.image.get_rect(center=(int(en_screen_pos.x), int(en_screen_pos.y)))
                
                if 0 <= en_screen_pos.x <= WIDTH and 0 <= en_screen_pos.y <= HEIGHT:
                    screen.blit(en.image, en_rect)
                else:
                    dir_to_en = en_screen_pos - screen_center
                    if dir_to_en.length_squared() > 0:
                        dir_to_en = dir_to_en.normalize()
                        margin = 40
                        bx = clamp(screen_center.x + dir_to_en.x * (WIDTH / 2 - margin), margin, WIDTH - margin)
                        by = clamp(screen_center.y + dir_to_en.y * (HEIGHT / 2 - margin), margin, HEIGHT - margin)
                        border_pos = pygame.Vector2(bx, by)

                        arrow_angle = math.atan2(dir_to_en.y, dir_to_en.x)
                        tip = border_pos + dir_to_en * 15
                        left_w = tip - pygame.Vector2(math.cos(arrow_angle - math.radians(30)), math.sin(arrow_angle - math.radians(30))) * 10
                        right_w = tip - pygame.Vector2(math.cos(arrow_angle + math.radians(30)), math.sin(arrow_angle + math.radians(30))) * 10
                        pygame.draw.polygon(screen, (255, 0, 0), [tip, left_w, right_w])
#draws projectiles and missiles
            for m in missiles_group: 
                m_screen_pos = m.pos - camera_offset
                m_rect = m.image.get_rect(center=(int(m_screen_pos.x), int(m_screen_pos.y)))
                screen.blit(m.image, m_rect)

            for r in pdc_rounds_group:
                r_screen_pos = r.pos - camera_offset
                pygame.draw.circle(screen, (255, 255, 255), (int(r_screen_pos.x), int(r_screen_pos.y)), 2)

            for slug in slugs_group:
                s_screen_pos = slug.pos - camera_offset
                vel_dir = slug.velocity.normalize() if slug.velocity.length_squared() > 0 else pygame.Vector2(1, 0)
                tip = s_screen_pos + vel_dir * 16
                tail = s_screen_pos - vel_dir * 16
                pygame.draw.line(screen, (80, 0, 120), tail, tip, 12)
                pygame.draw.line(screen, (220, 100, 255), tail, tip, 4)

            status_text = "BLACKOUT!" if player.blackout_timer > 0 else f"Speed: {player.velocity.length() * 6:.1f} m/s | G-Force: {player.g_force:.1f}G | Hull: {player.hull}/{player.max_hull}"
            hud_render = font.render(status_text, True, (255, 50, 50) if player.blackout_timer > 0 else (0, 255, 0))
            screen.blit(hud_render, (20, 20))

            # subsystems hud
            sub_panel_x = 20
            sub_panel_y = HEIGHT - 130
            sub_panel_w = 230
            sub_panel_h = 110
            pygame.draw.rect(screen, (30, 30, 30), (sub_panel_x, sub_panel_y, sub_panel_w, sub_panel_h), border_radius=4)
            pygame.draw.rect(screen, (100, 100, 100), (sub_panel_x, sub_panel_y, sub_panel_w, sub_panel_h), 2, border_radius=4)

            sub_title = font.render("SUBSYSTEMS", True, (255, 255, 255))
            screen.blit(sub_title, (sub_panel_x + 10, sub_panel_y + 8))

            sy_offset = sub_panel_y + 32
            for sub_name, data in player.subsystems.items():
                hp = data["hp"]
                status = data["status"]
                color = (0, 255, 0) if status == "Stable" else (255, 50, 50)
                sub_text = font.render(f"{sub_name.replace('_', ' ').title()}: {int(hp)} ({status})", True, color)
                screen.blit(sub_text, (sub_panel_x + 10, sy_offset))
                sy_offset += 20

            # Draw hit notifications above subsystem panel
            notif_y = sub_panel_y - 10
            for notif in list(notifications):
                if not game_over:
                    notif["timer"] -= 1
                if notif["timer"] <= 0:
                    notifications.remove(notif)
                    continue
                notif_render = font.render(notif["text"], True, (255, 50, 50))
                screen.blit(notif_render, (20, notif_y))
                notif_y -= 22

            # intercept notification above ammo count
            intercept_y = sub_panel_y - 25
            for notif in list(intercept_notifications):
                if not game_over:
                    notif["timer"] -= 1
                if notif["timer"] <= 0:
                    intercept_notifications.remove(notif)
                    continue
                notif_render = font.render(notif["text"], True, (0, 255, 255))
                screen.blit(notif_render, (WIDTH - notif_render.get_width() - 20, intercept_y))
                intercept_y -= 22

            # weapons and ammo hud
            hud_x = WIDTH - 240
            hud_y = HEIGHT - 155
            hud_w = 220
            hud_h = 140
            pygame.draw.rect(screen, (30, 30, 30), (hud_x, hud_y, hud_w, hud_h), border_radius=4)
            pygame.draw.rect(screen, (100, 100, 100), (hud_x, hud_y, hud_w, hud_h), 2, border_radius=4)

            hud_title = font.render("WEAPONS & AMMO", True, (255, 255, 255))
            screen.blit(hud_title, (hud_x + 10, hud_y + 8))

            hy_offset = hud_y + 32
            light_count = player.ammo.get('light', 0)
            med_count = player.ammo.get('medium', 0)
            heavy_count = player.ammo.get('heavy', 0)
            nuke_count = player.ammo.get('nuke', 0)

            screen.blit(font.render(f"Light ({light_count})", True, (200, 200, 200)), (hud_x + 15, hy_offset))
            hy_offset += 22
            screen.blit(font.render(f"Medium ({med_count})", True, (200, 200, 200)), (hud_x + 15, hy_offset))
            hy_offset += 22
            screen.blit(font.render(f"Heavy ({heavy_count})", True, (200, 200, 200)), (hud_x + 15, hy_offset))
            hy_offset += 22
            screen.blit(font.render(f"Nuke ({nuke_count})", True, (200, 200, 200)), (hud_x + 25, hy_offset))
            hy_offset += 22

            if player.railguns:
                rg_cd_frames = player.railguns[0].cooldown
                rg_cd_sec = rg_cd_frames / 60.0
                rg_text = font.render(f"Railgun CD: {rg_cd_sec:.1f}s", True, (0, 255, 255) if rg_cd_frames == 0 else (255, 165, 0))
                screen.blit(rg_text, (hud_x + 10, hy_offset))
            else:
                rg_text = font.render("No Railgun", True, (150, 150, 150))
                screen.blit(rg_text, (hud_x + 10, hy_offset)) # used to be a typo here

            bar_y = 20
            for en in enemy_group:
                if en.alive():
                    bar_width = 200
                    bar_height = 16
                    bar_x = WIDTH - bar_width - 20
                    fill = max(0, en.hull / en.max_hull) * bar_width
                    
                    pygame.draw.rect(screen, (50, 50, 50), (bar_x, bar_y, bar_width, bar_height), border_radius=3)
                    if fill > 0:
                        pygame.draw.rect(screen, (255, 50, 50), (bar_x, bar_y, fill, bar_height), border_radius=3)
                    pygame.draw.rect(screen, (200, 200, 200), (bar_x, bar_y, bar_width, bar_height), 2, border_radius=3)
                    
                    enemy_text = font.render(f"{en.ship_type}: {int(max(0, en.hull))}/{en.max_hull}", True, (255, 255, 255))
                    screen.blit(enemy_text, (bar_x-20, bar_y + bar_height + 4))
                    bar_y += bar_height + 28

            if game_over:
                overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
                overlay.fill((0, 0, 0, 160))
                screen.blit(overlay, (0, 0))

                go_render = title_font.render(game_over_message, True, (255, 215, 0))
                screen.blit(go_render, (WIDTH // 2 - go_render.get_width() // 2, HEIGHT // 2 - 20))

            pygame.display.flip()
            clock.tick(60)
            await asyncio.sleep(0)

    pygame.quit()
asyncio.run(main())
